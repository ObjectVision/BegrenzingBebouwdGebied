container SourceData : using = "Classifications;units;Geography;classifications/bbg"
{
	#include<RegioIndelingen.dms>
	
	container BBG 
	{
		unit<uint32> BBG_Reeks_1996_2017
		:	StorageName     = "%SourceDataDir%/CBS/BestandBodemGebruik/CBS_MutatiebestandBBG1996_2017_v1.gpkg"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	DialogData      = "rdc_meter"
		{
			// attribute<rdc_meter>    Geometry (poly);
			attribute<rdc_meter>    geometry_simpl (poly)    := geos_simplify_multi_polygon(geometry, 1d);
			// attribute<bool>   IsStudyArea        := IsDefined(point_in_polygon(centroid_or_mid(geometry_simpl), Geography/StudyArea/geometry));
			// attribute<geography/StudyArea>   IsStudyArea        := point_in_polygon(centroid_or_mid(geometry_simpl), Geography/StudyArea/geometry);
			attribute<gg_src> CBSKlasse_rel_1996 := bbg_ek/CBSKlasseNr[value(BG96, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2000 := bbg_ek/CBSKlasseNr[value(BG00, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2003 := bbg_ek/CBSKlasseNr[value(BG03, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2006 := bbg_ek/CBSKlasseNr[value(BG06, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2008 := bbg_ek/CBSKlasseNr[value(BG08, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2010 := bbg_ek/CBSKlasseNr[value(BG10, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2012 := bbg_ek/CBSKlasseNr[value(BG12, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2015 := bbg_ek/CBSKlasseNr[value(BG15, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2017 := bbg_ek/CBSKlasseNr[value(BG17, bbg_ek)];
			
			attribute<rdc_meter> geometry_studyarea (poly) :=  geos_intersect(geometry_simpl,  Geography/StudyArea/geometry);
		}
		unit<uint32> BBG_Reeks_1996_2022
		:	StorageName     = "%SourceDataDir%/CBS/BestandBodemGebruik/CBS_Mutatiebestand_NBBG2022_v1_def_z3d.gpkg"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	DialogData      = "rdc_meter"
		{
			attribute<bool>   IsStudyArea        := IsDefined(point_in_polygon(centroid_or_mid(geometry_simpl), Geography/StudyArea/geometry));
			attribute<gg_src> CBSKlasse_rel_1996 := bbg_ek/CBSKlasseNr[value(BG96, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2000 := bbg_ek/CBSKlasseNr[value(BG00, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2003 := bbg_ek/CBSKlasseNr[value(BG03, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2006 := bbg_ek/CBSKlasseNr[value(BG06, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2008 := bbg_ek/CBSKlasseNr[value(BG08, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2010 := bbg_ek/CBSKlasseNr[value(BG10, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2012 := bbg_ek/CBSKlasseNr[value(BG12, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2015 := bbg_ek/CBSKlasseNr[value(BG15, bbg_ek)];
			attribute<gg_src> CBSKlasse_rel_2017 := bbg_ek/CBSKlasseNr[value(BG17, bbg_ek)];
			
			attribute<rdc_meter>    geometry_simpl (poly)    := geos_simplify_multi_polygon(geometry, 1d);
			// attribute<rdc_meter> geometry_studyarea (poly) :=  bg_intersect(Geometry,  Geography/StudyArea/geometry);
		}
		// 
		// unit<uint32> StudyArea := select_with_attr_by_cond(BBG_Reeks_1996_2017, BBG_Reeks_1996_2017/IsStudyArea);
		unit<uint32> StudyArea := select_with_attr_by_cond(BBG_Reeks_1996_2017, area(BBG_Reeks_1996_2017/geometry_studyarea, m2) > 0.1d);
		// unit<uint32> StudyArea := select_with_attr_by_cond(BBG_Reeks_1996_2022, BBG_Reeks_1996_2022/IsStudyArea);
	}
	
	// Copernicus HRL Imperviousness Density 2018 (0..100 = %, 254 = unclassifiable, 255 = outside
	// area; geen nodata gedeclareerd in de tif). NB: de tif heeft celgrootte 10,2046 m (gewarpt uit
	// het LAEA-grid) en wijkt dus af van het exacte 10 m rdc_10m-grid — GeoDMS meldt dit als
	// 'Factor difference'-warning bij het lezen. Vervangen door een correct naar het 10 m RD-grid
	// gewarpte IMD 2012: zie issue #1.
	attribute<uint16> Verharding (rdc_10m)
	: StorageName = "%SourceDataDir%/Overig/imperviousness_2018_010m_NL_rdc.tif"
	,	StorageReadOnly = "True"
	,	LazyCalculated = "true";
}