container SourceData : using = "Classifications;units;Geography;classifications/bbg"
{
	#include<RegioIndelingen.dms>
	
	container BBG 
	{
		unit<uint32> BBG_Reeks_1996_2017
		:	StorageName     = "%SourceDataDir%/CBS/BestandBodemGebruik/CBS_MutatiebestandBBG1996_2017_v1.gpkg"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	DialogData      = "rdc_meter"
		{
			attribute<rdc_meter>    geometry_simpl     (poly) := geos_simplify_multi_polygon(geometry, 1d);
			attribute<rdc_meter>    geometry_studyarea (poly) := geos_intersect(geometry_simpl, Geography/StudyArea/geometry);
			attribute<bool>         IsStudyArea        := point_in_polygon(centroid_or_mid(geometry_simpl), Geography/StudyArea/geometry); //is wellicht efficienter dan geos_intersect
			// klasse-relaties per peiljaar. Getypeerd op de jaartal-geschakelde CBSKlasse (via een
			// value-cast vanaf de 2010-codering): zo werken Analysis' lookups voor elk peiljaar op
			// hetzelfde klassendomein. Deze kolommen zijn alleen betekenisvol bij BBG_Year < 2020.
			attribute<CBSKlasse> CBSKlasse_rel_1996 := value(CBS2010KlasseEK/CBSKlasseNr[value(BG96, CBS2010KlasseEK)], CBSKlasse);
			attribute<CBSKlasse> CBSKlasse_rel_2000 := value(CBS2010KlasseEK/CBSKlasseNr[value(BG00, CBS2010KlasseEK)], CBSKlasse);
			attribute<CBSKlasse> CBSKlasse_rel_2003 := value(CBS2010KlasseEK/CBSKlasseNr[value(BG03, CBS2010KlasseEK)], CBSKlasse);
			attribute<CBSKlasse> CBSKlasse_rel_2006 := value(CBS2010KlasseEK/CBSKlasseNr[value(BG06, CBS2010KlasseEK)], CBSKlasse);
			attribute<CBSKlasse> CBSKlasse_rel_2008 := value(CBS2010KlasseEK/CBSKlasseNr[value(BG08, CBS2010KlasseEK)], CBSKlasse);
			attribute<CBSKlasse> CBSKlasse_rel_2010 := value(CBS2010KlasseEK/CBSKlasseNr[value(BG10, CBS2010KlasseEK)], CBSKlasse);
			attribute<CBSKlasse> CBSKlasse_rel_2012 := value(CBS2010KlasseEK/CBSKlasseNr[value(BG12, CBS2010KlasseEK)], CBSKlasse);
			attribute<CBSKlasse> CBSKlasse_rel_2015 := value(CBS2010KlasseEK/CBSKlasseNr[value(BG15, CBS2010KlasseEK)], CBSKlasse);
			attribute<CBSKlasse> CBSKlasse_rel_2017 := value(CBS2010KlasseEK/CBSKlasseNr[value(BG17, CBS2010KlasseEK)], CBSKlasse);
		}
		// NBBG-reeks: nieuwe CBS-classificatie (o.a. 13 metro/sneltram, 36 zonnepark, 52/53
		// agrarisch gesplitst; buitenland = 90) EN nieuwe geometrie — inclusief landaanwinning
		// zoals IJburg, die in de 1996-2017-reeks ontbreekt (blijft daar water, klasse 70).
		unit<uint32> BBG_Reeks_1996_2022
		:	StorageName     = "%SourceDataDir%/CBS/BestandBodemGebruik/CBS_Mutatiebestand_NBBG2022_v1_def_z3d.gpkg"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	DialogData      = "rdc_meter"
		{
			attribute<rdc_meter>    geometry_simpl     (poly) := geos_simplify_multi_polygon(geometry, 1d);
			attribute<rdc_meter>    geometry_studyarea (poly) := geos_intersect(geometry_simpl, Geography/StudyArea/geometry);

			// alleen betekenisvol bij BBG_Year >= 2020 (dan is CBSKlasse = CBS2020Klasse)
			attribute<CBSKlasse> CBSKlasse_rel_2020 := value(CBS2020KlasseEK/CBSKlasseNr[value(NBBG20, CBS2020KlasseEK)], CBSKlasse);
			attribute<CBSKlasse> CBSKlasse_rel_2022 := value(CBS2020KlasseEK/CBSKlasseNr[value(NBBG22, CBS2020KlasseEK)], CBSKlasse);
		}

		// bronkeuze per peiljaar: t/m 2017 het mutatiebestand 1996-2017, vanaf 2020 de NBBG-reeks
		unit<uint32> StudyArea := = uint32(ModelParameters/BBG_Year) >= 2020
			? 'select_with_attr_by_cond(BBG_Reeks_1996_2022, area(BBG_Reeks_1996_2022/geometry_studyarea, m2) > 0.1d)'
			: 'select_with_attr_by_cond(BBG_Reeks_1996_2017, area(BBG_Reeks_1996_2017/geometry_studyarea, m2) > 0.1d)';
	}
	
	// Verhardingskaart per peiljaar: Copernicus HRL Imperviousness Density (0..100 = %,
	// 254 = unclassifiable, 255 = outside area).
	// - 2012-laag: IMD 2012 (20 m, EU-mozaïek EPSG:3035), gewarpt naar het exacte 10 m rdc-grid
	//   (gdalwarp -te -60650 223320 341920 637060 -tr 10 10 -r near -ot UInt16, nodata 255
	//   gedeclareerd) — leest zonder 'Factor difference'-warning en zonder zee-als-255-waarden.
	// - 2018-laag: oude warp met celgrootte 10,2046 m en zonder nodata-declaratie; bij gelegenheid
	//   met hetzelfde recept opnieuw warpen vanaf de EU-bron (rest van issue #1).
	// Peiljaren t/m 2015 gebruiken de 2012-kaart, latere de 2018-kaart. Voor 1996-2010 zijn t.z.t.
	// ook IMD 2006/2009 toe te voegen (zelfde recept).
	attribute<uint16> Verharding (rdc_10m)
	: StorageName = "= uint32(ModelParameters/BBG_Year) <= 2015 ? '%SourceDataDir%/Overig/imperviousness_2012_010m_NL_rdc.tif' : '%SourceDataDir%/Overig/imperviousness_2018_010m_NL_rdc.tif'"
	,	StorageReadOnly = "True"
	,	LazyCalculated = "true";
}