////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

unit<UInt8> CBS2010Klasse : NrOfRows = 39
{
	attribute<UInt8> id:=id(.);
	
	parameter<UInt32> nrAttr: [14];
	
	unit<Uint32> Elements := Range(uint32, 0, nrAttr * #.)
	{
		attribute<String> Text: [ // @USERINPUT
		//   EK2010,   BrushColor,         name,                               ,Aggr_ref                  , Sector_ref          ,IsGrootWater Aggr2_ref       ,Aggr3_ref                  ,   ,   ,             , LU_ModelType
				 '0', 'rgb(128,128,128)', 'oorspronkelijk_noData',             'Overigen'                 , 'Overigen'          , 'FALSE', 'Overigen',        'Overigen','0','0',       'Groen',    'Groen', '0','Overig',
				'10', 'rgb(115,76,0)',    'Spoorwegen',                        'Infra'                    , 'Overigen'          , 'FALSE', 'Overigen',        'Bebouwd','4','4',        'Rood',     'Groen', '5','Infra',
				'11', 'rgb(254,100,100)', 'hoofdweg',                          'Infra'                    , 'Overigen'          , 'FALSE', 'Overigen',        'Bebouwd','4','4',        'Rood',     'Groen', '5','Infra',
				'12', 'rgb(109,109,109)', 'Vliegveld',                         'Infra'                    , 'Overigen'          , 'FALSE', 'Overigen',        'Bebouwd','4','4',        'Rood',     'Groen', '5','Infra',
				'20', 'rgb(254, 50,0)',   'woongebied',                        'woongebied'               , 'Wonen'             , 'FALSE', 'Wonen',           'Bebouwd','1','1',        'Rood',     'Groen', '1','Wonen',
				'21', 'rgb(254,150,0)',   'Detailhandel_en_horeca',            'Detailhandel_en_horeca'   , 'Werken'            , 'FALSE', 'Werken',          'Bebouwd','2','2',        'Rood',     'Paars','11','Werken',
				'22', 'rgb(254,238,0)',   'openbare_Voorzieningen',            'Voorzieningen'            , 'Werken'            , 'FALSE', 'Werken',          'Bebouwd','2','2',        'Rood',     'Paars','10','Werken',
				'23', 'rgb(254,132,25)',  'sociaal_culturele_Voorzieningen',   'Voorzieningen'            , 'Werken'            , 'FALSE', 'Werken',          'Bebouwd','2','2',        'Rood',     'Groen', '8','Werken',
				'24', 'rgb(169,169,169)', 'bedrijfsterreinen',                 'bedrijfsterreinen'        , 'Werken'            , 'FALSE', 'Werken',          'Bebouwd','2','2',        'Rood',     'Paars', '6','Werken',
				'30', 'rgb(179,122,157)', 'stortplaatsen',                     'Overigen'                 , 'Overigen'          , 'FALSE', 'Overigen',        'Bebouwd','2','2',        'Rood',     'Groen','14','Overig',
				'31', 'rgb(179,122,157)', 'wrakkenopslagplaatsen',             'Overigen'                 , 'Overigen'          , 'FALSE', 'Overigen',        'Bebouwd','2','2',        'Rood',     'Groen','14','Overig',
				'32', 'rgb(103,174,0)',   'begraafplaats',                     'begraafplaats'            , 'Overigen'          , 'FALSE', 'Stedelijk_groen', 'Bebouwd','2','2',        'Rood',     'Groen','12','Overig',
				'33', 'rgb(173,164,254)', 'delfstoffenwinning',                'Overigen'                 , 'Overigen'          , 'FALSE', 'Overigen',        'Bebouwd','2','2',        'Rood',     'Groen','14','Overig',
				'34', 'rgb(255,211,127)', 'bouwterrein',                       'Overigen'                 , 'Overigen'          , 'FALSE', 'Overigen',        'Bebouwd','3','3',        'Rood',     'Groen', '7','Overig',
				'35', 'rgb(254,250,194)', 'semiverhard_overig_terrein',        'Infra'                    , 'Overigen'          , 'FALSE', 'Overigen',        'Bebouwd','2','2',        'Rood',     'Groen', '9','Infra',
				'40', 'rgb(177,214,0)',   'parken_en_plantsoenen',             'parken_en_plantsoenen'    , 'Overigen'          , 'FALSE', 'Stedelijk_groen', 'Bebouwd','5','5',        'Rood',     'Groen','12','Overig',
				'41', 'rgb(100,150,0)',   'sportterreinen',                    'sportterreinen'           , 'Overigen'          , 'FALSE', 'Stedelijk_groen', 'Bebouwd','5','5',        'Rood',     'Groen','12','Overig',
				'42', 'rgb(174,151,75)',  'volkstuinen',                       'volkstuinen'              , 'Overigen'          , 'FALSE', 'Stedelijk_groen', 'Bebouwd','5','5',        'Rood',     'Groen','12','Overig',
				'43', 'rgb(226,254,95)',  'dagrecreatieve_terreinen',          'dagrecreatieve_terreinen' , 'Overigen'          , 'FALSE', 'Stedelijk_groen', 'Bebouwd','2','2',        'Rood',     'Groen', '4','Overig',
				'44', 'rgb(151,254,0)',   'Verblijfsrecreatie',                'Verblijfsrecreatie'       , 'Verblijfsrecreatie', 'FALSE', 'Stedelijk_groen', 'Bebouwd','2','2',        'Rood',     'Groen', '4','Verblijfsrecreatie',
				'50', 'rgb(214,133,137)', 'Glastuinbouw',                      'Overigen'                 , 'Overigen'          , 'FALSE', 'Werken',          'Bebouwd','6','6',        'Groen',    'Groen', '2','Overig',
				'51', 'rgb(233,255,190)', 'overige_agrarisch_gebruik',         'overige_agrarisch_gebruik', 'Overigen'          , 'FALSE', 'Landelijk_groen', 'Agrarisch','6','7',      'Groen',    'Groen', '2','',
				'60', 'rgb(103,174,0)',   'bos',                               'Natuur'                   , 'Overigen'          , 'FALSE', 'Landelijk_groen', 'Natuur','7','8',         'Groen',    'Groen', '3','Natuur',
				'61', 'rgb(254,223,223)', 'droog_natuurlijk_terrein',          'Natuur'                   , 'Overigen'          , 'FALSE', 'Landelijk_groen', 'Natuur','7','9',         'Groen',    'Groen', '3','Natuur',
				'62', 'rgb(105,213,180)', 'nat_natuurlijk_terrein',            'Natuur'                   , 'Overigen'          , 'FALSE', 'Landelijk_groen', 'Natuur','7','9',         'Groen',    'Groen', '3','Natuur',
				'70', 'rgb(151,219,242)', 'IJsselmeer_Markermeer',             'Water'                    , 'Overigen'          , 'TRUE',  'Overigen',        'Water','8','10',         'Groen',    'Groen','13','Water',
				'71', 'rgb(20,164,171)',  'afgesloten_zeearm',                 'Water'                    , 'Overigen'          , 'TRUE',  'Overigen',        'Water','8','10',         'Groen',    'Groen','13','Water',
				'72', 'rgb(151,219,242)', 'Rijn_en_Maas',                      'Water'                    , 'Overigen'          , 'TRUE',  'Overigen',        'Water','8','10',         'Groen',    'Groen','13','Water',
				'73', 'rgb(20,164,171)',  'Randmeer',                          'Water'                    , 'Overigen'          , 'TRUE',  'Overigen',        'Water','8','10',         'Groen',    'Groen','13','Water',
				'74', 'rgb(151,219,242)', 'spaarbekkens',                      'Water'                    , 'Overigen'          , 'FALSE', 'Overigen',        'Water','8','10',         'Groen',    'Groen','13','Water',
				'75', 'rgb(151,219,242)', 'water_met_een_recreatieve_functie', 'Water'                    , 'Overigen'          , 'FALSE', 'Overigen',        'Water','8','10',         'Groen',    'Groen','13','Water',
				'76', 'rgb(151,219,242)', 'water_met_delfstofwinningsfunctie', 'Water'                    , 'Overigen'          , 'FALSE', 'Overigen',        'Water','8','10',         'Groen',    'Groen','13','Water',
				'77', 'rgb(151,219,242)', 'vloei_en_of_slibveld',              'Water'                    , 'Overigen'          , 'FALSE', 'Overigen',        'Water','2','2',          'Groen',    'Groen','13','Water',
				'78', 'rgb(151,219,242)', 'overig_binnenwater',                'Water'                    , 'Overigen'          , 'FALSE', 'Overigen',        'Water','8','10',         'Groen',    'Groen','13','Water',
				'80', 'rgb(151,219,242)', 'Waddenzee_Eems_Dollard',            'Water'                    , 'Overigen'          , 'TRUE',  'Overigen',        'Water','9','11',         'Groen',    'Groen','13','Water',
				'81', 'rgb(151,219,242)', 'Oosterschelde',                     'Water'                    , 'Overigen'          , 'TRUE',  'Overigen',        'Water','8','10',         'Groen',    'Groen','13','Water',
				'82', 'rgb(151,219,242)', 'Westerschelde',                     'Water'                    , 'Overigen'          , 'TRUE',  'Overigen',        'Water','8','10',         'Groen',    'Groen','13','Water',
				'83', 'rgb(151,219,242)', 'Noordzee',                          'Water'                    , 'Overigen'          , 'TRUE',  'Overigen',        'Water','9','11',         'Groen',    'Groen','13','Water',
				 '0', 'rgb(255,255,255)', 'buitenland',                        'Overigen'                 , 'Overigen'          , 'FALSE', 'Overigen',        'Buitenland','0','',      'Groen',    'Groen', '0','Overig'
		], DialogType = "BrushColor";
	}
	
	attribute<CBS2010KlasseEK> EK2010                := value(Elements/Text[value(Uint32(id(.))* nrAttr + 0, Elements)], CBS2010KlasseEK);     //[0,10,11,12,20,21,22,23,24,30,31,32,33,34,35,40,41,42,43,44,50,51,60,61,62,70,71,72,73,74,75,76,77,78,80,81,82,83, 0];
	attribute<UInt32>          BrushColor            := ='union_data(., '+asItemList(Elements/Text[value(Uint32(id(.))* nrAttr + 1, Elements)])+')', DialogType = "BrushColor";
	attribute<String>          name                  := Elements/Text[value(Uint32(id(.))* nrAttr + 2, Elements)];
	attribute<String>          Aggr_ref              := Elements/Text[value(Uint32(id(.))* nrAttr + 3, Elements)];
	attribute<String>          Sector_ref            := Elements/Text[value(Uint32(id(.))* nrAttr + 4, Elements)];
	attribute<String>          Label                 := name, DialogType = "LabelText";
	
	attribute<bool>            IsPrimairBebouwdGebied := id(.) == V/woongebied
															|| id(.) == V/detailhandel_en_horeca
															|| id(.) == V/bedrijfsterreinen;
	
	attribute<bool>            IsSecundairBebouwdGebied_A := id(.) == V/openbare_voorzieningen
															|| id(.) == V/sociaal_culturele_voorzieningen
															|| id(.) == V/stortplaatsen
															|| id(.) == V/wrakkenopslagplaatsen
															|| id(.) == V/begraafplaats
															|| id(.) == V/parken_en_plantsoenen
															|| id(.) == V/sportterreinen
															|| id(.) == V/volkstuinen
															|| id(.) == V/dagrecreatieve_terreinen
															|| id(.) == V/water_met_een_recreatieve_functie
															|| id(.) == V/vloei_en_of_slibveld;
	
	attribute<bool>            IsSecundairBebouwdGebied_B := id(.) == V/spoorwegen
															|| id(.) == V/hoofdweg
															|| id(.) == V/afgesloten_zeearm
															|| id(.) == V/Rijn_en_Maas
															|| id(.) == V/Randmeer
															|| id(.) == V/overig_binnenwater;
	attribute<bool>            IsSecundairBebouwdGebied  := IsSecundairBebouwdGebied_A || IsSecundairBebouwdGebied_B;
	
	attribute<bool>            IsBuitengebied             := id(.) == V/vliegveld
															|| id(.) == V/delfstoffenwinning
															|| id(.) == V/bouwterrein
															|| id(.) == V/semiverhard_overig_terrein
															|| id(.) == V/verblijfsrecreatie
															|| id(.) == V/glastuinbouw
															|| id(.) == V/overige_agrarisch_gebruik
															|| id(.) == V/bos
															|| id(.) == V/droog_natuurlijk_terrein
															|| id(.) == V/nat_natuurlijk_terrein
															|| id(.) == V/IJsselmeer_Markermeer
															|| id(.) == V/spaarbekkens
															|| id(.) == V/water_met_delfstofwinningsfunctie
															|| id(.) == V/Waddenzee_Eems_Dollard
															|| id(.) == V/Oosterschelde
															|| id(.) == V/Westerschelde
															|| id(.) == V/Noordzee
															|| id(.) == V/buitenland;
	
	// Voor de omsloten-analyse in Analysis/Stap1 telt binnenwater mee als buitengebied:
	// infrastructuur sluit secundair gebied alleen af van het buitengebied als het geen
	// water/waterweg is (rapport §2.2.2). De AML doet dit in de selectie 'buiten1':
	// "prim <> 1 AND seca <> 1 AND secb <> 1 OR bbg = 78 OR bbg = 71 OR bbg = 72 OR bbg = 73".
	// Alleen spoorwegen (10) en hoofdwegen (11) uit Secundair_B werken dus afsluitend.
	// NB codering 0: het mutatiebestand codeert 'buitenland' als 0 (tabel 1 voert dit als
	// klasse 90); invert(EK2010) pakt bij de dubbele 0-rij de laatste, dus code 0 -> buitenland
	// -> buitengebied, conform tabel 1. Dat wijkt bewust af van de AML, die code 0 (daar de
	// nodata-code) juist uitsloot; eventuele niet-gekarteerde 0-vlakken binnen NL tellen hier
	// dus ook als buitengebied.
	attribute<bool>            IsBuitengebied_OmslotenAnalyse := IsBuitengebied
															|| id(.) == V/afgesloten_zeearm
															|| id(.) == V/Rijn_en_Maas
															|| id(.) == V/Randmeer
															|| id(.) == V/overig_binnenwater;


	container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
}